-- Migration V3 (lesson 03): a NEW table added after V1/V2 already ran in production.
-- Existing databases get it on next startup (Flyway) — fresh ones replay V1 → V2 → V3.
import kotlin.Int;
import kotlin.time.Instant;

CREATE TABLE reviews (
    id         INTEGER PRIMARY KEY,
    book_id    INTEGER NOT NULL REFERENCES books (id) ON DELETE CASCADE,
    reviewer   TEXT NOT NULL,
    rating     INTEGER AS Int NOT NULL CHECK (rating BETWEEN 1 AND 5),
    body       TEXT,
    created_at TEXT AS Instant NOT NULL,
    UNIQUE (book_id, reviewer)
);

INSERT INTO reviews (book_id, reviewer, rating, body, created_at) VALUES
    (1, 'ada', 5, 'A masterpiece', '2026-02-01T10:00:00Z'),
    (1, 'alan', 4, NULL, '2026-02-03T09:00:00Z'),
