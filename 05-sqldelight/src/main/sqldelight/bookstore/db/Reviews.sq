selectForBook:
SELECT *
FROM reviews
WHERE book_id = :bookId
ORDER BY created_at;

insert:
INSERT INTO reviews (book_id, reviewer, rating, body, created_at)
VALUES (:bookId, :reviewer, :rating, :body, :createdAt)
RETURNING id;

averageRatings:
SELECT books.title, round(avg(reviews.rating), 2) AS average_rating, count(*) AS review_count
FROM reviews
JOIN books ON books.id = reviews.book_id
GROUP BY books.id
ORDER BY average_rating DESC, books.title;
